#!/bin/bash
shopt -qs extglob

printUsage()
{
    cat <<HELPTEXT
Run any tests found in the given DIR.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" 'DIR [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac
if [ $# -ne 1 ]; then
    printUsage "$0" >&2
    exit 2
fi
testDirspec="${1:?}"; shift
testDirspec="${testDirspec%/}"
testSubject="${testDirspec}/"
testSubject="${testDirspec//@(tests\/|\/tests)/}"
testSubject="${testSubject%/}"

componentCount="${COMPONENT_COUNT:+ (}${COMPONENT_COUNT}${COMPONENT_COUNT:+)}"

runProve()
(   # Note: Subshell here because of the chdir.
    cd "$testDirspec" || return 3
    prove -I.
)

hasFoundTests=
runTestsFor()
{
    local what="${1:?}"; shift

    hasFoundTests=t
    printf '\n%sTesting %s%s with %s:\n' "$RUNTESTSIN_RUN_PREFIX" "$testSubject" "$componentCount" "$what"
    "$@"; local status=$?
    [ -z "$RUNTESTSIN_RUN_SUFFIX" ] || printf '%s\n' "$RUNTESTSIN_RUN_SUFFIX"
    return $status
}

! hasMatchingFile '*.bats' "${testDirspec}/" \
    || runTestsFor Bats bats -r "${testDirspec}/"

! hasMatchingFile 'test*.py' "${testDirspec}/" \
    || runTestsFor Python python3 -m unittest discover --verbose --start-directory "${testDirspec}/"

[ ! -d "${testDirspec}/t" ] \
    || runTestsFor Perl runProve

if [ -r "${testDirspec}/Makefile" ] \
    && { make --question test >/dev/null 2>&1; [ $? -ne 2 ]; }	# inlined "makeHasTarget test"
then
    runTestsFor Make make --directory "${testDirspec}/" test
fi

if [ ! "$hasFoundTests" ]; then
    printf >&2 'Note: No tests found in %s\n' "$testDirspec"
    exit 99
fi
