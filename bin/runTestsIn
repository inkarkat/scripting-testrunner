#!/bin/bash
shopt -qs extglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--check] DIR [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Run any tests found in the given DIR.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --check		Just print what tests would be run, but don't actually
			run them.
HELPTEXT
}

isCheck=
case "$1" in
    --help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
    --check)		shift; isCheck=t;;
esac
if [ $# -ne 1 ]; then
    printUsage "$0" >&2
    exit 2
fi
testDirspec="${1:?}"; shift
testDirspec="${testDirspec%/}"
testSubject="${testDirspec}/"
testSubject="${testDirspec//@(tests\/|\/tests)/}"
testSubject="${testSubject%/}"

componentCount="${COMPONENT_COUNT:+ (}${COMPONENT_COUNT}${COMPONENT_COUNT:+)}"

runProve()
(   # Note: Subshell here because of the chdir.
    cd "$testDirspec" || return 3
    prove -I.
)

hasFoundTests=
runTestsFor()
{
    local what="${1:?}"; shift

    hasFoundTests=t
    if [ "$isCheck" ]; then
	printf '%sCould test %s%s with %s.\n' "$RUNTESTSIN_RUN_PREFIX" "$testSubject" "$componentCount" "$what"
	return 0
    fi

    printf '\n%sTesting %s%s with %s:\n' "$RUNTESTSIN_RUN_PREFIX" "$testSubject" "$componentCount" "$what"
    "$@"; local status=$?
    [ -z "$RUNTESTSIN_RUN_SUFFIX" ] || printf '%s\n' "$RUNTESTSIN_RUN_SUFFIX"
    return $status
}

! hasMatchingFile '*.bats' "${testDirspec}/" \
    || runTestsFor Bats bats -r "${testDirspec}/"

! hasMatchingFile 'test*.py' "${testDirspec}/" \
    || runTestsFor Python python3 -m unittest discover --verbose --start-directory "${testDirspec}/"

[ ! -d "${testDirspec}/t" ] \
    || runTestsFor Perl runProve

if [ -r "${testDirspec}/Makefile" ] \
    && { make --question test >/dev/null 2>&1; [ $? -ne 2 ]; }	# inlined "makeHasTarget test"
then
    runTestsFor Make make --directory "${testDirspec}/" test
fi

if [ ! "$hasFoundTests" ]; then
    [ "$isCheck" ] || printf >&2 'Note: No tests found in %s\n' "$testDirspec"
    exit 99
fi
