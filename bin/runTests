#!/bin/bash

: ${EACHCOMPONENTDO_EXEC_END=;}

printUsage()
{
    cat <<HELPTEXT
Run any tests found in each COMPONENT-DIR, which is appended to COMMAND.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "[-c|--command \"ADDITIONAL-COMMANDLINE\" [-c ...] | --exec ADDITIONAL-SIMPLECOMMAND [...] ${EACHCOMPONENTDO_EXEC_END} [--exec ...]] [--] COMPONENT-DIR [...] [-?|-h|--help]"
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

exec eachComponentDo --what Testing --command runTestsIn "$@"
