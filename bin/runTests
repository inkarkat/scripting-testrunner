#!/bin/bash
shopt -qs nullglob

: ${EACHCOMPONENTDO_EXEC_END=;}

printUsage()
{
    cat <<HELPTEXT
Run all tests in tests/*/ / any tests found in each COMPONENT-DIR.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "[--check] [--exit-on-failure] [-c|--command \"ADDITIONAL-COMMANDLINE\" [-c ...] | --exec ADDITIONAL-SIMPLECOMMAND [...] ${EACHCOMPONENTDO_EXEC_END} [--exec ...]] [--] [COMPONENT-DIR [...]] [-?|-h|--help]"
}

isCheck=
typeset -a runTestsInArgs=()
typeset -a eachComponentDoArgs=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--check)	runTestsInArgs+=("$1"); shift; eachComponentDoArgs+=(--quiet --no-setup); isCheck=t;;
	--exit-on-failure)
			eachComponentDoArgs+=("$1"); shift;;
	--command|-c)	eachComponentDoArgs+=("$1" "${2?}"); shift; shift;;
	--exec)		eachComponentDoArgs+=("$1"); shift
			while [ $# -gt 0 -a "$1" != "$EACHCOMPONENTDO_EXEC_END" ]
			do
			    eachComponentDoArgs+=("$1"); shift
			done
			eachComponentDoArgs+=("$1"); shift
			;;
	--)		eachComponentDoArgs+=("$1"); shift; break;;
	*)		break;;
    esac
done

if [ $# -eq 0 ]; then
    set -- tests/*
    if [ $# -eq 0 ]; then
	[ "$isCheck" ] || echo >&2 'ERROR: No tests/COMPONENT-DIR(s) found.'
	exit 99
    fi
fi

exec eachComponentDo --what Testing --status-99-is-noop \
    --exec runTestsIn "${runTestsInArgs[@]}" "${EACHCOMPONENTDO_DIR_MARKER-{\}}" "${EACHCOMPONENTDO_EXEC_END-;}" \
    "${eachComponentDoArgs[@]}" "$@"
